# ============================================================
# MatchForge 环境变量示例
# ------------------------------------------------------------
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略, 不要提交真实密钥。
# ============================================================

# ── 运行环境 ───────────────────────────────────────────────
# development: 本地开发/演示 (允许 demo 模式); production: 生产 (强制关闭 demo)
APP_ENV=development

# ── 演示模式 (仅本地演示, 生产环境必须保持 false) ─────────
# KB_DEMO_MODE=true 时, 在非生产环境下启用 demo 登录通道与 demo/admin demo
# 静态 token。生产环境 (APP_ENV=production) 下无论此值如何, demo 通道一律关闭。
KB_DEMO_MODE=false

# demo / admin demo 静态 token: 仅本地演示用, 留空则对应通道关闭。
# 不要在生产环境配置这些值。源码不提供默认 token。
# KB_DEMO_TOKEN=
# KB_ADMIN_TOKEN=

# ── 演示账号密码 (仅 scripts/seed_auth_users.py 使用) ─────
# 显式 seed 脚本读取; 留空则不创建对应账号。不要提交真实密码。
# DEMO_USER_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# ── LLM / Embedding ────────────────────────────────────────
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL=glm-5.2
LLM_MODEL_LIGHT=DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIM=1024

# ── MySQL (知识库主库) ─────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=matchforge
MYSQL_PASSWORD=
MYSQL_DATABASE=matchforge
# 可选: 直接覆盖知识库连接串 (默认由 MYSQL_* 拼接)
# KB_DATABASE_URL=mysql+pymysql://matchforge:@127.0.0.1:3306/matchforge?charset=utf8mb4

# ── Milvus (向量库) ────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── Neo4j (图谱) ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── PostgreSQL (会话历史等) ────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=matchforge
POSTGRES_PASSWORD=
POSTGRES_DATABASE=matchforge

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── API (FastAPI) ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
