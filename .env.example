# ===== LLM / Embedding（通义千问 DashScope，OpenAI 兼容）=====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_MODEL_LIGHT=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024
# 可选：改用 SiliconFlow bge-m3（与 data/milvus_collections.py 默认一致）
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# ===== MySQL 8.0 (docker-compose: mysql:3306) =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=matchforge
MYSQL_PASSWORD=matchforge123
MYSQL_DATABASE=matchforge

# ===== Milvus 2.4 (docker-compose: milvus:19530) =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Neo4j 5.20 (docker-compose: neo4j:7687) =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=matchforge123

# ===== Redis 7 (docker-compose: redis:6379) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=matchforge123

# ===== MinIO (docker-compose: minio:9000/9001) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=matchforge

# ===== 可观测（可选）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ===== API（FastAPI）=====
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ===== 企业私域知识库 (Company-Level RAG) =====
# 知识库主库 (Source of Truth)。默认 SQLite 本地文件; 切 MySQL:
#   KB_DATABASE_URL=mysql+pymysql://matchforge:matchforge123@127.0.0.1:3306/pc_industry?charset=utf8mb4
KB_DATABASE_URL=sqlite:///data/knowledge.db
# 公司库来源 MySQL (优先级1, 不可达自动降级到 CSV 种子文件)
COMPANY_MYSQL_URL=mysql+pymysql://matchforge:matchforge123@127.0.0.1:3306/pc_industry?charset=utf8mb4
# 向量库: auto(优先 Milvus, 降级 Local) | milvus | local
KB_VECTOR_STORE=auto
# 新建 Milvus 集合 (现有 knowledge_chunks 缺过滤字段, 非破坏式新建)
MILVUS_COLLECTION_KB=company_knowledge_chunks
# 知识生成并发
KB_COMPANY_CONCURRENCY=3
KB_LLM_CONCURRENCY=2
# Demo 模式标记 (AI 生成内容标 ai_generated_demo, 防止误部署为生产事实)
KB_DEMO_MODE=true
# RAG 检索
KB_RAG_TOP_K=6
KB_RAG_MIN_SCORE=0.15
# 知识库 API 鉴权令牌 (管理员)
KB_ADMIN_TOKEN=kb-admin-demo
KB_DEMO_TOKEN=kb-demo-user